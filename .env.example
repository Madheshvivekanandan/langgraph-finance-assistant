# Copy to .env and fill in real values. Never commit .env.

# Postgres (docker-compose uses these; DATABASE_URL must match)
POSTGRES_USER=myfinance
POSTGRES_PASSWORD=myfinance
POSTGRES_DB=myfinance
DATABASE_URL=postgresql+psycopg://myfinance:myfinance@localhost:5433/myfinance

# OpenAI (used from Phase 2 onward for transaction categorization)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Keep LangSmith tracing off so no run data leaves this machine
LANGSMITH_TRACING=false
